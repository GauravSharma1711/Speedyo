  dealershipAgreement DealershipVehicleAgreement? @relation(fields: [dealershipAgreementId], references: [id], onDelete: SetNull)

  managedSaleRequest ManagedSaleRequest? @relation("ManagedSaleVehicle")

  // Relations
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  posts  Post[]
  testDriveRequests TestDriveRequest[]

  messages             Message[]
  verificationRequests VerificationRequest[]
  transfers            VehicleTransfer[]
  editRequests         VehicleEditRequest[]

