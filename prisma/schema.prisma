model TestDriveRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Vehicle
  vehicleId String @map("vehicle_id")

  // Requester info (denormalized — supports guests too)
  requester_name  String
  requester_email String
  requester_phone String?

  // Scheduling
  requested_date String   // "2025-04-30"
  requested_time String   // "10:00 AM"
  confirmed_date String?
  confirmed_time String?

  // Status & notes
  status              TestDriveStatus @default(pending)
  additional_notes    String?
  cancellation_reason String?
  seller_notes        String?

  // Optional — link to a logged-in user if they have an account
  userId String? @map("user_id")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@map("test_drive_requests")
}

