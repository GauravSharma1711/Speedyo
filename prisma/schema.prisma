model VehicleTransfer {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  vehicleId         String         @map("vehicle_id")
  transfer_type     TransferType
  buyerId           String         @map("buyer_id")
  sellerId          String?        @map("seller_id")
  current_step      Int            @default(1)
  steps_completed   Int[]          @default([])
  initiated_date    DateTime?
  completed_date    DateTime?
  status            TransferStatus @default(in_progress)
  admin_notes       String?
  user_facing_notes String?
  createdById       String?        @map("created_by_id")
  buyer             User           @relation("BuyerTransfers", fields: [buyerId], references: [id], onDelete: Cascade)
  createdBy         User?          @relation("CreatedTransfers", fields: [createdById], references: [id])
  seller            User?          @relation("SellerTransfers", fields: [sellerId], references: [id])
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("vehicle_transfers")
}

model VerificationRequest {
  id               String                    @id @default(cuid())
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  vehicleId        String                    @map("vehicle_id")
  userId           String                    @map("user_id")
  contact_phone    String
  user_email       String?
  user_name        String?
  preferred_time   String?
  documents_info   String?
  inspection_notes String?
  status           VerificationRequestStatus @default(pending)
  user             User                      @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}




model PaymentTransaction {
  id               String              @id @default(cuid())
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  userId           String              @map("user_id")

  
  transaction_type PaymentTransactionType
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("JPY")
  status           PaymentStatus       @default(pending)

  // Square specific
  square_payment_id     String?        @unique
  square_order_id       String?
  square_customer_id    String?
  square_receipt_url    String?

  
  subscription_tier     SubscriptionTier?   
  slots_purchased       Int?
  promo_code_used       String?

  // Relations
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice          Invoice?

  @@index([userId])
  @@index([status])
  @@index([transaction_type])
  @@map("payment_transactions")
}

model Invoice {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  userId              String         @map("user_id")
  transactionId       String         @unique @map("transaction_id")

  invoice_number      String         @unique  // e.g. "INV-2026-0001"
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("JPY")
  status              InvoiceStatus  @default(unpaid)
  description         String
  due_date            DateTime?
  paid_at             DateTime?
  invoice_url         String?        // generated PDF url if needed

    period_start        DateTime?      
  period_end          DateTime? 

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction         PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("invoices")
}

