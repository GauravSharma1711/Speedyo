model Post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  video_url          String?        // for video posts
video_thumbnail    String?        // video preview image
article_title      String?        // for article posts  
article_excerpt    String?        // short description for articles



  // Required fields
  content  String
  authorId String @map("author_id")

  // Optional vehicle link
  vehicleId String? @map("vehicle_id")

  // Image arrays (different resolutions)
  images            String[]
  images_thumbnails String[]
  images_small      String[]
  images_medium     String[]

  // Post type
  post_type PostType @default(text)

  // Counters
  likes            Int @default(0)
  shares           Int @default(0)
  views            Int @default(0)
  comments_count   Int @default(0)
  engagement_score Int @default(0)

  // Reactions as JSONB
  reactions      Json @default("{\"like\":0,\"love\":0,\"wow\":0,\"fire\":0,\"laugh\":0,\"angry\":0}")
  user_reactions Json @default("[]")

  // Relations
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Required fields
  postId   String @map("post_id")
  content  String
  authorId String @map("author_id")

  // Optional
  parentCommentId String? @map("parent_comment_id")

  // Counters (kept as plain columns for fast reads)
  likes         Int @default(0)
  replies_count Int @default(0)

  // Reactions stored as JSONB
  reactions Json @default("{\"like\":0,\"love\":0,\"wow\":0,\"fire\":0,\"laugh\":0,\"angry\":0}")

  // User reactions array stored as JSONB
  user_reactions Json @default("[]")

  // Relations
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Vehicle {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Required fields
  title String
  make  String
  model String
