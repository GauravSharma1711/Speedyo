generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                               String                       @id @default(cuid())
  createdAt                        DateTime                     @default(now()) @map("created_at")
  updatedAt                        DateTime                     @updatedAt @map("updated_at")
  role                             Role                         @default(user)
  email                            String                       @unique
  full_name                        String?
  bio                              String?
  profile_image                    String?
  user_type                        UserType                     @default(guest)
  location                         String?
  phone                            String?
  dealership_verification_status   DealershipVerificationStatus @default(not_submitted)
  dealership_selected_tier         DealershipSelectedTier?
  business_name                    String?
  business_address                 String?
  business_city                    String?
  business_state                   String?
  business_zip                     String?
  business_license_urls            String[]
  tax_id_number                    String?
  verification_fee_paid            Boolean                      @default(false)
  admin_verification_notes         String?
  welcome_email_sent               Boolean                      @default(false)
  setup_completed                  Boolean                      @default(false)
  verificationCode                 String
  verificationCodeExpiry           DateTime
  isVerified                       Boolean                      @default(false)
  password                         String
  comments                         Comment[]
  created_agreements               DealershipVehicleAgreement[] @relation("AdminAgreements")
  email_notifications              EmailNotifications?
  feedback                         Feedback[]
  followers                        Follow[]                     @relation("UserFollowers")
  following                        Follow[]                     @relation("UserFollowing")
  activatedGuestPurchases          GuestPurchase[]              @relation("ActivatedGuestPurchases")
  inapp_notifications              InAppNotifications?
  createdLiaisonAgreements         LiaisonAgreement[]           @relation("AdminLiaisonAgreements")
  reviewedLiaisonApplications      LiaisonApplication[]         @relation("AdminLiaisonApplications")
  managedSaleRequests              ManagedSaleRequest[]         @relation("UserManagedSaleRequests")
  receivedMessages                 Message[]                    @relation("ReceivedMessages")
  sentMessages                     Message[]                    @relation("SentMessages")
  receivedNotifications            Notification[]               @relation("ReceivedNotifications")
  sentNotifications                Notification[]               @relation("SentNotifications")
  createdPhotographerAgreements    PhotographerAgreement[]      @relation("AdminPhotographerAgreements")
  reviewedPhotographerApplications PhotographerApplication[]    @relation("AdminPhotographerApplications")
  posts                            Post[]
  private_seller_slots             PrivateSellerSlots?
  seller_subscription              SellerSubscription?
  vehicleEditRequests              VehicleEditRequest[]         @relation("UserVehicleEditRequests")
  buyerTransfers                   VehicleTransfer[]            @relation("BuyerTransfers")
  sellerTransfers                  VehicleTransfer[]            @relation("SellerTransfers")
  vehicles                         Vehicle[]
  verificationRequests             VerificationRequest[]        @relation("UserVerificationRequests")

  @@map("users")
}

model PrivateSellerSlots {
  id        String @id @default(cuid())
  userId    String @unique @map("user_id")
  purchased Int    @default(0)
  used      Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("private_seller_slots")
}

model SellerSubscription {
  id                      String           @id @default(cuid())
  userId                  String           @unique @map("user_id")
  tier                    SubscriptionTier @default(none)
  expires_at              DateTime?
  vehicles_sold_this_year Int              @default(0)
  square_subscription_id  String?
  square_customer_id      String?
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_subscriptions")
}

model EmailNotifications {
  id                   String  @id @default(cuid())
  userId               String  @unique @map("user_id")
  new_follower_post    Boolean @default(true)
  new_follower_vehicle Boolean @default(true)
  all_emails           Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_notifications")
}

model InAppNotifications {
  id                   String  @id @default(cuid())
  userId               String  @unique @map("user_id")
  new_follower_post    Boolean @default(true)
  new_follower_vehicle Boolean @default(true)
  all_notifications    Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inapp_notifications")
}

model Post {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  content           String
  authorId          String    @map("author_id")
  vehicleId         String?   @map("vehicle_id")
  images            String[]
  images_thumbnails String[]
  images_small      String[]
  images_medium     String[]
  post_type         PostType  @default(text)
  likes             Int       @default(0)
  shares            Int       @default(0)
  views             Int       @default(0)
  comments_count    Int       @default(0)
  engagement_score  Int       @default(0)
  reactions         Json      @default("{\"wow\": 0, \"fire\": 0, \"like\": 0, \"love\": 0, \"angry\": 0, \"laugh\": 0}")
  user_reactions    Json      @default("[]")
  comments          Comment[]
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  vehicle           Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@map("posts")
}

model Comment {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  postId          String    @map("post_id")
  content         String
  authorId        String    @map("author_id")
  parentCommentId String?   @map("parent_comment_id")
  likes           Int       @default(0)
  replies_count   Int       @default(0)
  reactions       Json      @default("{\"wow\": 0, \"fire\": 0, \"like\": 0, \"love\": 0, \"angry\": 0, \"laugh\": 0}")
  user_reactions  Json      @default("[]")
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Vehicle {
  id                      String                      @id @default(cuid())
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  title                   String
  make                    String
  model                   String
  year                    Int
  price                   Decimal                     @db.Decimal(12, 2)
  mileage                 Int?
  condition               VehicleCondition?
  description             String?
  location                String?
  fuel_type               FuelType?
  transmission            Transmission?
  primary_image           String?
  primary_image_thumbnail String?
  primary_image_small     String?
  primary_image_medium    String?
  images                  String[]
  images_thumbnails       String[]
  images_small            String[]
  images_medium           String[]
  verified                Boolean                     @default(false)
  featured                Boolean                     @default(false)
  website_managed         Boolean                     @default(false)
  status                  VehicleStatus               @default(available)
  views                   Int                         @default(0)
  authorId                String?                     @map("author_id")
  original_owner_id       String?
  dealership_name         String?
  recurring_availability  Json                        @default("[]")
  booked_slots            Json                        @default("[]")
  dealershipAgreementId   String?                     @map("dealership_agreement_id")
  managedSaleRequest      ManagedSaleRequest?         @relation("ManagedSaleVehicle")
  messages                Message[]
  posts                   Post[]
  editRequests            VehicleEditRequest[]
  transfers               VehicleTransfer[]
  author                  User?                       @relation(fields: [authorId], references: [id])
  dealershipAgreement     DealershipVehicleAgreement? @relation(fields: [dealershipAgreementId], references: [id])
  verificationRequests    VerificationRequest[]

  @@map("vehicles")
}

model DealershipVehicleAgreement {
  id                  String          @id @default(cuid())
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  dealership_name     String
  representative_name String
  email               String
  address             String?
  phone               String?
  license_number      String?
  service_fee_amount  Decimal?        @db.Decimal(12, 2)
  status              AgreementStatus @default(draft)
  agreement_url       String?
  agreement_accepted  Boolean         @default(false)
  signed_by_name      String?
  signed_at           DateTime?
  created_by_admin_id String?
  admin_notes         String?
  createdByAdmin      User?           @relation("AdminAgreements", fields: [created_by_admin_id], references: [id])
  vehicles            Vehicle[]

  @@map("dealership_vehicle_agreements")
}

model Feedback {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  satisfaction_rating Int
  feedback_text       String
  userId              String?          @map("user_id")
  user_email          String?
  user_name           String?
  category            FeedbackCategory @default(general)
  status              FeedbackStatus   @default(new)
  admin_notes         String?
  user                User?            @relation(fields: [userId], references: [id])

  @@map("feedback")
}

model Follow {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")
  followerId String   @map("follower_id")
  followedId String   @map("followed_id")
  followed   User     @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@map("follows")
}

model GuestPurchase {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  guest_email           String
  guest_name            String
  slots_purchased       Int
  amount_paid           Decimal             @db.Decimal(12, 2)
  payment_id            String              @unique
  payment_gateway       PaymentGateway      @default(square)
  promo_code_used       String?
  status                GuestPurchaseStatus @default(pending_payment)
  activated_at          DateTime?
  activated_for_user_id String?
  activatedForUser      User?               @relation("ActivatedGuestPurchases", fields: [activated_for_user_id], references: [id])

  @@map("guest_purchases")
}

model LiaisonAgreement {
  id                      String                 @id @default(cuid())
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  agreement_title         String                 @default("Speedio Dealership Partnership Liaison Agreement")
  position_title          String                 @default("Bilingual Dealership Liaison — Speedio Dealership Outreach Program")
  fixed_fee_percentage    Decimal                @default(10) @db.Decimal(5, 2)
  residual_pay_percentage Decimal                @default(3) @db.Decimal(5, 2)
  termination_notice_days Int                    @default(30)
  agreement_start_date    DateTime?
  agreement_end_date      DateTime?
  status                  LiaisonAgreementStatus @default(draft)
  agreement_url           String?
  created_by_admin_id     String?
  admin_notes             String?
  application_id          String?
  application             LiaisonApplication?    @relation(fields: [application_id], references: [id])
  createdByAdmin          User?                  @relation("AdminLiaisonAgreements", fields: [created_by_admin_id], references: [id])

  @@map("liaison_agreements")
}

model LiaisonApplication {
  id                   String                   @id @default(cuid())
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  full_name            String
  email                String
  phone                String
  language_proficiency LanguageProficiency
  motivation           String
  address              String?
  previous_experience  String?
  automotive_knowledge String?
  availability         String?
  resume_url           String?
  status               LiaisonApplicationStatus @default(pending_review)
  admin_notes          String?
  reviewed_by_admin_id String?
  reviewed_at          DateTime?
  liaisonAgreement     LiaisonAgreement[]
  reviewedByAdmin      User?                    @relation("AdminLiaisonApplications", fields: [reviewed_by_admin_id], references: [id])

  @@map("liaison_applications")
}

model ManagedSaleRequest {
  id                         String                       @id @default(cuid())
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  contact_full_name          String
  contact_email              String
  contact_phone              String?
  vehicle_title              String?
  vehicle_make               String?
  vehicle_model              String?
  vehicle_year               Int?
  vehicle_mileage            Int?
  vehicle_condition          String?
  vehicle_description        String?
  vehicle_fuel_type          String?
  vehicle_transmission       String?
  vehicle_location           String?
  seller_asking_price        Decimal?                     @db.Decimal(12, 2)
  financing_available        String?
  warranty_available         String?
  warranty_link              String?
  vehicle_images             String[]
  vehicle_images_thumbnails  String[]
  vehicle_images_small       String[]
  vehicle_images_medium      String[]
  drive_type                 String?
  engine_size                String?
  body_type                  String?
  exterior_color             String?
  interior_color             String?
  doors                      Int?
  seating_capacity           Int?
  steering_wheel             String?
  current_plate_type         String?
  shaken_valid_until         String?
  road_tax_paid              String?
  jci_insurance_valid_until  String?
  title_type                 String?
  registration_location      String?
  engine_type                String?
  power_output               String?
  fuel_efficiency            String?
  drivetrain                 String?
  suspension_type            String?
  brakes                     String?
  tire_condition             String?
  battery_condition          String?
  hybrid_system_status       String?
  maintenance_history        String?
  power_sliding_doors        String?
  headlights                 String?
  fog_lights                 String?
  alloy_wheels               Boolean?
  spoiler                    Boolean?
  tinted_windows             Boolean?
  roof_type                  String?
  side_mirrors               String?
  body_condition             String?
  air_conditioning           String?
  upholstery                 String?
  seat_type                  String?
  seat_adjustments           String?
  navigation_system          String?
  rear_camera                Boolean?
  parking_sensors            String?
  power_windows              String?
  interior_lighting          String?
  cup_holders_storage        Boolean?
  child_lock_isofix          Boolean?
  display_screen_size        String?
  rear_entertainment_system  Boolean?
  digital_dashboard_display  Boolean?
  infotainment_system        String[]
  steering_wheel_controls    String[]
  airbags                    String[]
  bluetooth                  Boolean?
  usb_ports                  Boolean?
  twelve_v_outlet            Boolean?
  smart_key_push_start       Boolean?
  keyless_entry              Boolean?
  remote_door_locking        Boolean?
  voice_command_hands_free   Boolean?
  abs                        Boolean?
  esc_stability_control      Boolean?
  lane_departure_warning     Boolean?
  collision_mitigation       Boolean?
  cruise_control             String?
  traction_control           Boolean?
  hill_start_assist          Boolean?
  immobilizer_alarm          Boolean?
  seat_belt_sensors          Boolean?
  access_arrangements        Json                         @default("{}")
  service_fee_amount         Decimal?                     @db.Decimal(12, 2)
  owner_receives_amount      Decimal?                     @db.Decimal(12, 2)
  final_sale_price_for_buyer Decimal?                     @db.Decimal(12, 2)
  status                     ManagedSaleStatus            @default(pending_review)
  admin_notes                String?
  user_facing_notes          String?
  terms_agreed               Boolean                      @default(false)
  cancellation_reason        String?
  edit_requests              Json                         @default("[]")
  submitted_by_user_id       String?
  created_vehicle_id         String?                      @unique
  createdVehicle             Vehicle?                     @relation("ManagedSaleVehicle", fields: [created_vehicle_id], references: [id])
  submittedByUser            User?                        @relation("UserManagedSaleRequests", fields: [submitted_by_user_id], references: [id])
  messages                   Message[]
  inspectionChecklists       VehicleInspectionChecklist[]

  @@map("managed_sale_requests")
}

model Message {
  id                   String              @id @default(cuid())
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  senderId             String              @map("sender_id")
  recipientId          String              @map("recipient_id")
  content              String
  conversation_id      String?
  message_type         MessageType         @default(general)
  read                 Boolean             @default(false)
  translated_content   String?
  original_language    String?
  translated_to        String?
  vehicleId            String?             @map("vehicle_id")
  managedSaleRequestId String?             @map("managed_sale_request_id")
  test_drive_details   Json?
  managedSaleRequest   ManagedSaleRequest? @relation(fields: [managedSaleRequestId], references: [id])
  recipient            User                @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender               User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  vehicle              Vehicle?            @relation(fields: [vehicleId], references: [id])

  @@index([conversation_id])
  @@index([senderId, recipientId])
  @@map("messages")
}

model Notification {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now()) @map("created_at")
  recipientId         String           @map("recipient_id")
  type                NotificationType
  content             String
  senderId            String?          @map("sender_id")
  read                Boolean          @default(false)
  related_entity_type String?
  related_entity_id   String?
  url                 String?
  icon                String?
  recipient           User             @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender              User?            @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model OISTTradeInRequest {
  id                 String               @id @default(cuid())
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  full_name          String
  email              String
  vehicle_make       String
  vehicle_model      String
  vehicle_year       String
  vehicle_mileage    String
  vehicle_condition  OISTVehicleCondition
  facebook_profile   String?
  additional_details String?
  status             OISTTradeInStatus    @default(pending)

  @@index([email])
  @@index([status])
  @@map("oist_trade_in_requests")
}

model PhotographerAgreement {
  id                      String                      @id @default(cuid())
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  agreement_title         String                      @default("Speedio Photographer Partnership Agreement")
  position_title          String                      @default("Automotive Photographer - Speedio Platform")
  fixed_percentage        Decimal                     @default(10) @db.Decimal(5, 2)
  termination_notice_days Int                         @default(30)
  agreement_start_date    DateTime?
  agreement_end_date      DateTime?
  status                  PhotographerAgreementStatus @default(draft)
  agreement_url           String?
  application_id          String?
  created_by_admin_id     String?
  admin_notes             String?
  application             PhotographerApplication?    @relation(fields: [application_id], references: [id])
  createdByAdmin          User?                       @relation("AdminPhotographerAgreements", fields: [created_by_admin_id], references: [id])

  @@map("photographer_agreements")
}

model PhotographerApplication {
  id                                String                        @id @default(cuid())
  createdAt                         DateTime                      @default(now()) @map("created_at")
  updatedAt                         DateTime                      @updatedAt @map("updated_at")
  full_name                         String
  email                             String
  phone                             String
  photography_experience_years      Int
  motivation                        String
  address                           String?
  automotive_photography_experience String?
  portfolio_url                     String?
  equipment                         String?
  availability                      String?
  location_preferences              String?
  sample_work_urls                  String[]
  status                            PhotographerApplicationStatus @default(pending_review)
  admin_notes                       String?
  reviewed_by_admin_id              String?
  reviewed_at                       DateTime?
  photographerAgreement             PhotographerAgreement[]
  reviewedByAdmin                   User?                         @relation("AdminPhotographerApplications", fields: [reviewed_by_admin_id], references: [id])

  @@index([email])
  @@index([status])
  @@map("photographer_applications")
}

model SupportTicket {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  name             String
  email            String
  subject          String
  message          String
  ticket_type      TicketType     @default(general)
  status           TicketStatus   @default(open)
  priority         TicketPriority @default(medium)
  assigned_to      String?
  resolution_notes String?

  @@index([email])
  @@index([status, priority])
  @@map("support_tickets")
}

model VehicleEditRequest {
  id                 String                   @id @default(cuid())
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  vehicleId          String                   @map("vehicle_id")
  requestedByUserId  String                   @map("requested_by_user_id")
  requested_changes  Json
  reason             String
  status             VehicleEditRequestStatus @default(pending)
  admin_notes        String?
  processed_by_admin String?
  processed_at       DateTime?
  requestedByUser    User                     @relation("UserVehicleEditRequests", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  vehicle            Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("vehicle_edit_requests")
}

model VehicleInspectionChecklist {
  id                        String              @id @default(cuid())
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  date_of_inspection        DateTime
  inspector_name            String
  dealership_name           String?
  warranty                  String?
  repair_service_details    String?
  verified_by_speedio       String?
  dealership_representative String?
  inspection_notes          String?
  overall_condition         String?
  recommended_sale_price    Decimal?            @db.Decimal(12, 2)
  vehicle_info              Json                @default("{}")
  exterior_condition        Json                @default("[]")
  interior_condition        Json                @default("[]")
  engine_mechanical         Json                @default("[]")
  documentation             Json                @default("[]")
  photos_media              Json                @default("[]")
  managedSaleRequestId      String?             @map("managed_sale_request_id")
  managedSaleRequest        ManagedSaleRequest? @relation(fields: [managedSaleRequestId], references: [id])

  @@index([managedSaleRequestId])
  @@map("vehicle_inspection_checklists")
}

model VehicleTransfer {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  vehicleId         String         @map("vehicle_id")
  transfer_type     TransferType
  buyerId           String         @map("buyer_id")
  sellerId          String?        @map("seller_id")
  current_step      Int            @default(1)
  steps_completed   Int[]          @default([])
  initiated_date    DateTime?
  completed_date    DateTime?
  status            TransferStatus @default(in_progress)
  admin_notes       String?
  user_facing_notes String?
  buyer             User           @relation("BuyerTransfers", fields: [buyerId], references: [id], onDelete: Cascade)
  seller            User?          @relation("SellerTransfers", fields: [sellerId], references: [id])
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("vehicle_transfers")
}

model VerificationRequest {
  id               String                    @id @default(cuid())
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  vehicleId        String                    @map("vehicle_id")
  userId           String                    @map("user_id")
  contact_phone    String
  user_email       String?
  user_name        String?
  preferred_time   String?
  documents_info   String?
  inspection_notes String?
  status           VerificationRequestStatus @default(pending)
  user             User                      @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

enum FeedbackCategory {
  general
  marketplace
  feed
  messaging
  managed_sales
  dashboard
  other
}

enum FeedbackStatus {
  new
  reviewed
  in_progress
  resolved
}

enum AgreementStatus {
  draft
  pending_signature
  signed
  cancelled
}

enum VehicleCondition {
  excellent
  good
  fair
  poor
}

enum VehicleStatus {
  available
  pending
  sold
  cancelled
  hidden
  unavailable
}

enum FuelType {
  gasoline
  diesel
  hybrid
  electric
}

